<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio & Grand Opening Restoran Elegan</title>
    <style>
        /* Reset & Gaya Dasar */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            scroll-behavior: smooth;
        }
        body {
            background-color: #121212;
            color: #f5f5f5;
            line-height: 1.6;
        }

        /* Navigasi */
        nav {
            background-color: rgba(18, 18, 18, 0.95);
            border-bottom: 1px solid #333;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        nav .logo {
            font-size: 1.4rem;
            font-weight: bold;
            color: #d4af37;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        nav ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }
        nav ul li a {
            color: #ddd;
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.3s;
        }
        nav ul li a:hover {
            color: #d4af37;
        }

        /* Bagian Portofolio Owner */
        .portfolio-section {
            padding: 80px 10%;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 50px;
            background: radial-gradient(circle at top right, #262015, #121212);
        }
        .photo-frame {
            width: 250px;
            height: 250px;
            border-radius: 20px;
            overflow: hidden;
            border: 3px solid #d4af37;
            box-shadow: 0 15px 35px rgba(212, 175, 55, 0.25);
            position: relative;
        }
        /* Memutar foto agar berdiri tegak */
        .photo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: rotate(-90deg) scale(1.15);
        }
        .bio-content {
            max-width: 550px;
        }
        .tag {
            color: #d4af37;
            font-weight: bold;
            letter-spacing: 2px;
            font-size: 0.85rem;
            text-transform: uppercase;
            display: block;
            margin-bottom: 8px;
        }
        .bio-content h1 {
            font-size: 2.6rem;
            margin-bottom: 15px;
            color: #ffffff;
        }
        .bio-content p {
            color: #bbb;
            margin-bottom: 25px;
        }
        .skills-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
        }
        .skill-chip {
            background-color: #1f1f1f;
            border: 1px solid #d4af37;
            color: #d4af37;
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 0.85rem;
        }
        .gold-btn {
            display: inline-block;
            background-color: #d4af37;
            color: #121212;
            padding: 12px 28px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            transition: transform 0.2s, background 0.3s;
        }
        .gold-btn:hover {
            background-color: #f1c40f;
            transform: scale(1.03);
        }

        /* Banner Pembukaan Restoran */
        .opening-banner {
            padding: 70px 10%;
            text-align: center;
            background-color: #1a1a1a;
            border-top: 1px solid #2a2a2a;
            border-bottom: 1px solid #2a2a2a;
        }
        .opening-banner h2 {
            font-size: 2.2rem;
            color: #d4af37;
            margin-bottom: 15px;
        }
        .opening-banner p {
            max-width: 680px;
            margin: 0 auto 30px auto;
            color: #ccc;
        }
        .countdown-card {
            background: linear-gradient(145deg, #222, #181818);
            border: 1px solid #d4af37;
            padding: 30px;
            border-radius: 12px;
            max-width: 650px;
            margin: 0 auto;
        }
        .countdown-card h3 {
            font-size: 1.4rem;
            color: #fff;
            margin-bottom: 10px;
        }
        .highlight {
            color: #d4af37;
            font-weight: bold;
        }

        /* Galeri Menu Restoran */
        .gallery-section {
            padding: 80px 10%;
            text-align: center;
        }
        .gallery-section h2 {
            font-size: 2.2rem;
            color: #fff;
            margin-bottom: 10px;
        }
        .gallery-section .desc {
            color: #999;
            margin-bottom: 45px;
        }
        .cards-wrapper {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
            gap: 30px;
        }
        .food-card {
            background-color: #1c1c1c;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2c2c2c;
            transition: border-color 0.3s, transform 0.3s;
            text-align: left;
        }
        .food-card:hover {
            border-color: #d4af37;
            transform: translateY(-6px);
        }
        .food-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }
        .food-body {
            padding: 22px;
        }
        .food-body h3 {
            color: #d4af37;
            margin-bottom: 8px;
        }
        .food-body p {
            font-size: 0.9rem;
            color: #aaa;
            margin-bottom: 18px;
        }
        .food-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .food-price {
            font-weight: bold;
            font-size: 1.1rem;
            color: #fff;
        }
        .order-link {
            color: #d4af37;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: bold;
        }

        /* Lokasi & Reservasi */
        .location-section {
            padding: 60px 10%;
            background-color: #181818;
            text-align: center;
        }
        .location-section h2 {
            color: #d4af37;
            margin-bottom: 25px;
        }
        .grid-info {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 25px;
        }
        .box-info {
            background-color: #222;
            padding: 25px;
            border-radius: 10px;
            min-width: 240px;
            border-bottom: 3px solid #d4af37;
        }

        /* Footer */
        footer {
            background-color: #0d0d0d;
            color: #777;
            text-align: center;
            padding: 25px;
            font-size: 0.85rem;
            border-top: 1px solid #222;
        }

        @media (max-width: 768px) {
            nav ul {
                display: none;
            }
            .bio-content {
                text-align: center;
            }
            .skills-list {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- Navigasi -->
    <nav>
        <div class="logo">Gourmet Royal</div>
        <ul>
            <li><a href="#tentang">Portofolio</a></li>
            <li><a href="#peresmian">Grand Opening</a></li>
            <li><a href="#hidangan">Signature Menu</a></li>
            <li><a href="#alamat">Kontak</a></li>
        </ul>
    </nav>

    <!-- Bagian 1: Portofolio Diri Sendiri -->
    <section id="tentang" class="portfolio-section">
        <div class="photo-frame">
            <!-- Pastikan nama file foto sama persis: foto.jpg -->
            <img src="foto.jpg" alt="Foto Profil Pemilik">
        </div>
        <div class="bio-content">
            <span class="tag">Portofolio Web Design • Kelas XII</span>
            <h1> Clarissa Adella Simbolon </h1>
            <p>Selamat datang di halaman portofolio digital saya. Sebagai pelajar Kelas XII yang antusias di bidang desain web dan bisnis kuliner, saya mempersembahkan karya website sekaligus peresmian restoran impian saya, <strong>Gourmet Royal Bistro</strong>.</p>
            <div class="skills-list">
                <span class="skill-chip">Web Design</span>
                <span class="skill-chip">Culinary Entrepreneur</span>
                <span class="skill-chip">Creative Branding</span>
            </div>
            <a href="#peresmian" class="gold-btn">Detail Grand Opening</a>
        </div>
    </section>

    <!-- Bagian 2: Pengumuman Pembukaan Restoran -->
    <section id="peresmian" class="opening-banner">
        <h2>✨ GRAND OPENING CEREMONY ✨</h2>
        <p>Rasakan pengalaman bersantap mewah dengan cita rasa terbaik. Kami mengundang Anda hadir dalam acara pembukaan resmi restoran kami.</p>
        <div class="countdown-card">
            <h3>VOUCHER MAKAN GRATIS & DISKON 40%</h3>
            <p>Untuk 50 pengunjung pertama pada hari pembukaan!<br>
            <span class="highlight">Sabtu, 28 November 2026 • Pukul 11.00 WIB</span></p>
        </div>
    </section>

    <!-- Bagian 3: Daftar Menu Andalan -->
    <section id="hidangan" class="gallery-section">
        <h2>Signature Menu</h2>
        <p class="desc">Sajian istimewa yang disiapkan langsung oleh tim chef profesional kami</p>
        
        <div class="cards-wrapper">
            <!-- Item 1 -->
            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=600&q=80" alt="Steak Daging Panggang">
                <div class="food-body">
                    <h3>Royal Ribeye Steak</h3>
                    <p>Daging sapi premium panggang sempurna disajikan dengan saus lada hitam dan kentang tumbuk.</p>
                    <div class="food-footer">
                        <span class="food-price">Rp 85.000</span>
                        <a href="#alamat" class="order-link">Reservasi &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Item 2 -->
            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1563379926898-05f4575a45d8?auto=format&fit=crop&w=600&q=80" alt="Pasta Creamy">
                <div class="food-body">
                    <h3>Truffle Creamy Pasta</h3>
                    <p>Spaghetti al dente dengan saus krim keju parmesan, jamur champignon, dan minyak truffle.</p>
                    <div class="food-footer">
                        <span class="food-price">Rp 48.000</span>
                        <a href="#alamat" class="order-link">Reservasi &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Item 3 -->
            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=600&q=80" alt="Minuman Mocktail">
                <div class="food-body">
                    <h3>Golden Sunset Mocktail</h3>
                    <p>Minuman segar racikan ekstrak jeruk mandarin, markisa, daun mint, dan soda dingin.</p>
                    <div class="food-footer">
                        <span class="food-price">Rp 25.000</span>
                        <a href="#alamat" class="order-link">Reservasi &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bagian 4: Informasi Lokasi -->
    <section id="alamat" class="location-section">
        <h2>Informasi & Reservasi Meja</h2>
        <div class="grid-info">
            <div class="box-info">
                <h3>📍 Lokasi Restoran</h3>
                <p>Jl. Sudirman No. 88, Pusat Kota</p>
            </div>
            <div class="box-info">
                <h3>🕒 Jam Operasional</h3>
                <p>Senin - Minggu (11.00 - 23.00 WIB)</p>
            </div>
            <div class="box-info">
                <h3>📞085287819860</h3>
                <p>Instagram: @Rissa___7.id</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Project Web Design Kelas XII • Karya [Tulis Nama Lengkap Kamu]</p>
    </footer>

</body>
</html>